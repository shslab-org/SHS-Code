--- a/test_textproc.py
+++ b/test_textproc.py
@@ -19,6 +19,69 @@ def test_word_count_empty():  # FAILS — known bug
     assert word_count("") == 0
 
 
+# --- Regression tests for word_count fix ---
+
+
+def test_word_count_punctuation_with_double_space():
+    """Punctuation attached to words and consecutive spaces must not inflate count."""
+    assert word_count("Hello,  world!!") == 2
+
+
+def test_word_count_dots_between_letters():
+    """Internal punctuation splits a token into separate words."""
+    assert word_count("a...b") == 2
+
+
+def test_word_count_empty_string():
+    """Empty string yields zero words."""
+    assert word_count("") == 0
+
+
+def test_word_count_only_punctuation():
+    """A string of only punctuation yields zero words."""
+    assert word_count("!@#$%") == 0
+
+
+def test_word_count_multiple_spaces():
+    """Consecutive whitespace must not produce empty tokens."""
+    assert word_count("foo   bar    baz") == 3
+
+
+def test_word_count_tabs_and_newlines():
+    """Tabs and newlines are whitespace and must not produce empty tokens."""
+    assert word_count("foo\tbar\nbaz") == 3
+
+
+def test_word_count_leading_trailing_whitespace():
+    """Leading/trailing whitespace must not produce empty tokens."""
+    assert word_count("   hello world   ") == 2
+
+
+def test_word_count_leading_trailing_punctuation():
+    """Punctuation surrounding a word is stripped."""
+    assert word_count("...hello!!!") == 1
+
+
+def test_word_count_mixed_punctuation():
+    """Mixed punctuation around and between words."""
+    assert word_count("  --'Hello,'  she said.  ") == 3
+
+
+def test_word_count_unicode_letters():
+    """Unicode word characters are counted as words."""
+    assert word_count("café résumé") == 2
+
+
+def test_word_count_numbers():
+    """Numeric tokens count as words."""
+    assert word_count("I have 42 apples") == 4
+
+
+def test_word_count_only_whitespace():
+    """Whitespace-only string yields zero words."""
+    assert word_count("   \t\n  ") == 0
+
+
 def test_reverse_words():
     assert reverse_words("hello world") == "world hello"
 
