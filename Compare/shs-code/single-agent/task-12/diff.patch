--- a/textproc.py
+++ b/textproc.py
@@ -6,10 +6,11 @@ import re
 def word_count(text: str) -> int:
     """Return the number of words in text.
 
-    KNOWN BUG: splits only on single spaces, so punctuation attached to
-    words inflates counts and consecutive spaces create empty tokens.
+    A word is a sequence of non-whitespace characters with surrounding
+    punctuation stripped. Tokens that contain no alphanumeric characters
+    after stripping (e.g. '!@#$%') are not counted as words.
     """
-    return len(text.split(" "))
+    return sum(1 for token in re.findall(r"\S+", text) if re.search(r"\w", token))
 
 
 def reverse_words(text: str) -> str:
