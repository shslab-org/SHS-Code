 # benchlib — small utility library used for agent benchmarking
 
 
+class Calculator:
+    """A simple arithmetic calculator.
+
+    All operations are instance methods so callers can subclass or
+    substitute alternative implementations if needed.
+    """
+
+    def add(self, a: float, b: float) -> float:
+        """Return the sum of a and b."""
+        return a + b
+
+    def sub(self, a: float, b: float) -> float:
+        """Return a minus b."""
+        return a - b
+
+    def mul(self, a: float, b: float) -> float:
+        """Return the product of a and b."""
+        return a * b
+
+    def div(self, a: float, b: float) -> float:
+        """Safely divide a by b.
+
+        Raises ZeroDivisionError when b is zero.
+        """
+        if b == 0:
+            raise ZeroDivisionError("division by zero")
+        return a / b
+
+
+# Shared default instance used by the module-level wrappers below.
+_default = Calculator()
+
+
