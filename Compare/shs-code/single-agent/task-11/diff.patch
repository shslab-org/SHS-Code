@@ -0,0 +1,64 @@
+"""Email validation utilities."""
+
+import re
+
+# Pre-compiled regex fragments for clarity and performance.
+# Local part: 1-64 chars from [A-Za-z0-9._%+-], must not start or end with '.'.
+_LOCAL_PART_RE = re.compile(
+    r"^(?![\.])([A-Za-z0-9._%+-]{1,64})(?<![\.])$"
+)
+
+# Domain part: 1-255 chars from [A-Za-z0-9.-], must not start or end with '-' or '.',
+# must contain no consecutive dots, must contain at least one dot, and the final
+# label (TLD) must be 2+ letters.
+_DOMAIN_PART_RE = re.compile(
+    r"^(?!-)(?!.*--)(?!.*\.\.)[A-Za-z0-9.-]{1,255}(?<![-.])$"
+)
+
+# Final label (TLD): 2+ letters, all alphabetic.
+_TLD_RE = re.compile(r"[A-Za-z]{2,}$")
+
+
+def validate_email(s: str) -> str:
+    """Validate an email address per the project spec.
+
+    Rules:
+      - Format: local@domain
+      - local: 1-64 chars from [A-Za-z0-9._%+-], must not start or end with '.'
+      - domain: 1-255 chars from [A-Za-z0-9.-], must not start or end with '-' or '.',
+        must contain no consecutive dots, must contain at least one dot,
+        and the final label (TLD) must be 2+ letters.
+
+    Returns:
+        The lowercased email if valid.
+
+    Raises:
+        ValueError: If the email is invalid.
+    """
+    if not isinstance(s, str):
+        raise ValueError("email must be a string")
+
+    # Must contain exactly one '@' separating local and domain.
+    if s.count("@") != 1:
+        raise ValueError("email must contain exactly one '@'")
+
+    local, _, domain = s.partition("@")
+    if not local or not domain:
+        raise ValueError("email must have non-empty local and domain parts")
+
+    # Local part checks.
+    if not _LOCAL_PART_RE.match(local):
+        raise ValueError("invalid local part")
+
+    # Domain part checks.
+    if not _DOMAIN_PART_RE.match(domain):
+        raise ValueError("invalid domain part")
+
+    if "." not in domain:
+        raise ValueError("domain must contain at least one dot")
+
+    # TLD check: final label must be 2+ letters.
+    if not _TLD_RE.search(domain):
+        raise ValueError("TLD must be 2+ letters")
+
+    return s.lower()
