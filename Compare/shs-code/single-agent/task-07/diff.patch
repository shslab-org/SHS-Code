+++ b/textproc.py
@@ -26,3 +26,15 @@ def capitalize_words(text: str) -> str:
     'hello world' -> 'Hello World'
     """
     return " ".join(w.capitalize() for w in text.split(" "))
+
+
+def slugify(text: str) -> str:
+    """Return a URL-safe slug for the given text.
+
+    Converts to lowercase, replaces any run of non-alphanumeric characters
+    with a single hyphen, collapses multiple hyphens, and strips leading
+    and trailing hyphens. Empty or whitespace-only input returns ''.
+    """
+    text = text.lower()
+    text = re.sub(r"[^a-z0-9]+", "-", text)
+    return text.strip("-")
