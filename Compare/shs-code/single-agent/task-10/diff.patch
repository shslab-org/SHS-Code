+"""Tests for fizzbuzz."""
+from fizzbuzz import fizzbuzz
+
+
+def test_fizzbuzz_divisible_by_15():
+    assert fizzbuzz(15) == 'fizzbuzz'
+
+
+def test_fizz_divisible_by_3():
+    assert fizzbuzz(9) == 'fizz'
+
+
+def test_buzz_divisible_by_5():
+    assert fizzbuzz(10) == 'buzz'
+
+
+def test_neither_returns_string():
+    assert fizzbuzz(7) == '7'
+
+
+def test_zero_edge_case():
+    # 0 is divisible by 15 (0 % 15 == 0), so it should return 'fizzbuzz'
+    assert fizzbuzz(0) == 'fizzbuzz'
