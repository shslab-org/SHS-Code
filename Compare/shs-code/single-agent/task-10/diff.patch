@@ -0,0 +1,12 @@
+"""FizzBuzz implementation."""
+
+
+def fizzbuzz(n):
+    """Return 'fizzbuzz' if n divisible by 15, 'fizz' if by 3, 'buzz' if by 5, else str(n)."""
+    if n % 15 == 0:
+        return 'fizzbuzz'
+    if n % 3 == 0:
+        return 'fizz'
+    if n % 5 == 0:
+        return 'buzz'
+    return str(n)
