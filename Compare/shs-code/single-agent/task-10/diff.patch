@@ -0,0 +1,20 @@
+"""Classic FizzBuzz implementation."""
+
+
+def fizzbuzz(n):
+    """Return 'fizzbuzz', 'fizz', 'buzz', or str(n) based on divisibility.
+
+    - 'fizzbuzz' if n is divisible by 15
+    - 'fizz' if n is divisible by 3
+    - 'buzz' if n is divisible by 5
+    - str(n) otherwise
+
+    Edge case: n=0 is divisible by every integer, so it returns 'fizzbuzz'.
+    """
+    if n % 15 == 0:
+        return "fizzbuzz"
+    if n % 3 == 0:
+        return "fizz"
+    if n % 5 == 0:
+        return "buzz"
+    return str(n)
