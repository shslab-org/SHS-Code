+++ b/safefunc/safefunc.py
@@ -0,0 +1,23 @@
+import os
+
+
+def write_function_name_to_file() -> str:
+    """Writes the function name to SAFEFUNC.txt in the current working directory.
+
+    Returns
+    -------
+    str
+        The name of the function.
+    """
+    file_name = "SAFEFUNC.txt"
+    file_path = os.path.join(os.getcwd(), file_name)
+    try:
+        with open(file_path, "w", encoding="utf-8") as f:
+            f.write("write_function_name_to_file\n")
+    except OSError as e:
+        raise IOError(f"Failed to write to {file_path}") from e
+    return "write_function_name_to_file"
+
+
+if __name__ == "__main__":
+    print(write_function_name_to_file())
