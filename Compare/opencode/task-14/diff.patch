+def test_reverse_words_single():
+    assert reverse_words("hello") == "hello"
+
+
+def test_reverse_words_empty():
+    assert reverse_words("") == ""
+
+
+def test_reverse_words_multiple_spaces():
+    assert reverse_words("hello  world  foo") == "foo  world  hello"
+
+
+def test_reverse_words_leading_trailing_space():
+    assert reverse_words(" hello world ") == " world hello "
+
+
+def test_reverse_words_three_words():
+    assert reverse_words("one two three") == "three two one"
+
+
+def test_reverse_words_punctuation():
+    assert reverse_words("Hello, world!") == "world! Hello,"
+
+
+def test_reverse_words_unicode():
+    assert reverse_words("café résumé") == "résumé café"
+
+
+def test_reverse_words_unicode_single():
+    assert reverse_words("café") == "café"
+
+
+def test_reverse_words_mixed_unicode():
+    assert reverse_words("hello naïve façade") == "façade naïve hello"
+
+
+def test_reverse_words_only_spaces():
+    assert reverse_words("   ") == "   "
+
