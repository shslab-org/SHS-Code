+from validators import validate_email
+
+import pytest
+
+
+def test_valid_simple():
+    assert validate_email("user@example.com") == "user@example.com"
+
+
+def test_valid_lowercases_result():
+    assert validate_email("User@Example.COM") == "user@example.com"
+
+
+def test_valid_plus_tag_and_dots_in_local():
+    assert validate_email("first.last+tag@sub.example.co") == "first.last+tag@sub.example.co"
+
+
+def test_valid_all_allowed_local_chars():
+    local = "aA1._%+-"
+    assert validate_email(f"{local}@example.com") == f"{local}@example.com"
+
+
+def test_valid_long_local_at_limit():
+    local = "a" * 64
+    assert validate_email(f"{local}@example.com") == f"{local}@example.com"
+
+
+def test_valid_long_domain_at_limit():
+    labels = ["a" * 63] * 4
+    domain = ".".join(labels)
+    assert len(domain) <= 255
+    assert validate_email(f"u@{domain}") == f"u@{domain}"
+
+
+def test_invalid_missing_at():
+    with pytest.raises(ValueError):
+        validate_email("userexample.com")
+
+
+def test_invalid_empty_local():
+    with pytest.raises(ValueError):
+        validate_email("@example.com")
+
+
+def test_invalid_empty_domain():
+    with pytest.raises(ValueError):
+        validate_email("user@")
+
+
+def test_invalid_non_string():
+    with pytest.raises(ValueError):
+        validate_email(123)
+
+
+def test_invalid_local_too_long():
+    with pytest.raises(ValueError):
+        validate_email(f"{'a' * 65}@example.com")
+
+
+def test_invalid_local_starts_with_dot():
+    with pytest.raises(ValueError):
+        validate_email(".user@example.com")
+
+
+def test_invalid_local_ends_with_dot():
+    with pytest.raises(ValueError):
+        validate_email("user.@example.com")
+
+
+def test_invalid_local_disallowed_char():
+    with pytest.raises(ValueError):
+        validate_email("us er@example.com")
+
+
+def test_invalid_local_other_disallowed_char():
+    with pytest.raises(ValueError):
+        validate_email("user!@example.com")
+
+
+def test_invalid_domain_starts_with_dash():
+    with pytest.raises(ValueError):
+        validate_email("user@-example.com")
+
+
+def test_invalid_domain_ends_with_dash():
+    with pytest.raises(ValueError):
+        validate_email("user@example.com-")
+
+
+def test_invalid_domain_starts_with_dot():
+    with pytest.raises(ValueError):
+        validate_email("user@.example.com")
+
+
+def test_invalid_domain_ends_with_dot():
+    with pytest.raises(ValueError):
+        validate_email("user@example.com.")
+
+
+def test_invalid_domain_consecutive_dots():
+    with pytest.raises(ValueError):
+        validate_email("user@example..com")
+
+
+def test_invalid_domain_no_dot():
+    with pytest.raises(ValueError):
+        validate_email("user@localhost")
+
+
+def test_invalid_tld_too_short():
+    with pytest.raises(ValueError):
+        validate_email("user@example.c")
+
+
+def test_invalid_tld_with_digit():
+    with pytest.raises(ValueError):
+        validate_email("user@example.c1")
+
+
+def test_invalid_empty_string():
+    with pytest.raises(ValueError):
+        validate_email("")
+
+
+def test_invalid_domain_too_long():
+    domain = ("a" * 63 + ".") * 4 + "a" * 63
+    with pytest.raises(ValueError):
+        validate_email(f"u@{domain}")
