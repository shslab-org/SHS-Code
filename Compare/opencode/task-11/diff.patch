+# benchlib validators
+
+import re
+
+
+_LOCAL_CHARS = re.compile(r"^[A-Za-z0-9._%+-]+$")
+_DOMAIN_CHARS = re.compile(r"^[A-Za-z0-9.-]+$")
+_TLD_RE = re.compile(r"^[A-Za-z]{2,}$")
+
+
+def validate_email(s: str) -> str:
+    """Validate an email address per the benchlib spec.
+
+    Returns the lowercased email when valid; raises ValueError otherwise.
+    """
+    if not isinstance(s, str):
+        raise ValueError("email must be a string")
+
+    if not s or len(s) > 320:
+        raise ValueError("email length out of range")
+
+    at_index = s.rfind("@")
+    if at_index <= 0 or at_index == len(s) - 1:
+        raise ValueError("email must contain a single '@' separating local and domain")
+
+    local = s[:at_index]
+    domain = s[at_index + 1:]
+
+    if not (1 <= len(local) <= 64):
+        raise ValueError("local part must be 1-64 characters")
+    if not (1 <= len(domain) <= 255):
+        raise ValueError("domain must be 1-255 characters")
+
+    if not _LOCAL_CHARS.match(local):
+        raise ValueError("local part contains invalid characters")
+    if local.startswith(".") or local.endswith("."):
+        raise ValueError("local part must not start or end with '.'")
+
+    if not _DOMAIN_CHARS.match(domain):
+        raise ValueError("domain contains invalid characters")
+    if domain.startswith("-") or domain.endswith("-") or domain.startswith(".") or domain.endswith("."):
+        raise ValueError("domain must not start or end with '-' or '.'")
+    if ".." in domain:
+        raise ValueError("domain must not contain consecutive dots")
+
+    if "." not in domain:
+        raise ValueError("domain must contain at least one dot")
+
+    tld = domain.rsplit(".", 1)[-1]
+    if not _TLD_RE.match(tld):
+        raise ValueError("TLD must be 2+ letters")
+
+    return s.lower()
